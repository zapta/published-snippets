
// On board 27Mhz clock.
IO_LOC  "sys_clk"  4;
IO_PORT "sys_clk"  PULL_MODE=UP IO_TYPE=LVCMOS33;
CLOCK_LOC "ext_clk" BUFG;

// Test output pins.
IO_LOC  "test[0]"  73;
IO_LOC  "test[1]"  74;
IO_LOC  "test[2]"  75;
IO_LOC  "test[3]"  85;
IO_LOC  "test[4]"  77;

IO_PORT "test[0]"  PULL_MODE=UP  IO_TYPE=LVCMOS33;
IO_PORT "test[1]"  PULL_MODE=UP  IO_TYPE=LVCMOS33;
IO_PORT "test[2]"  PULL_MODE=UP  IO_TYPE=LVCMOS33;
IO_PORT "test[3]"  PULL_MODE=UP  IO_TYPE=LVCMOS33;
IO_PORT "test[4]"  PULL_MODE=UP  IO_TYPE=LVCMOS33;
